{
  "name": "his-citas",
  "version": "1.0.0",
  "description": "Módulo de control de citas médicas del HIS: API REST, MySQL en Docker y calendario con FullCalendar",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integracion": "node --test --test-concurrency=1 \"test/integracion/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "fullcalendar": "^6.1.21",
    "mysql2": "^3.24.4"
  }
}
